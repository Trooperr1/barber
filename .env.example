# Used by docker-compose.yml for the `api` service. Copy this to `.env` at
# the repo root and fill in real secrets before running `docker compose up`.

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Public URL of the web app, used to build client-facing reschedule/cancel
# links in booking confirmations and reminders.
WEB_BASE_URL=http://localhost:5173

# "console" logs notifications instead of sending them — good for local dev.
# Switch to "twilio" or "sendgrid" and fill in credentials to go live.
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
