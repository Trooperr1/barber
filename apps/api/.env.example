DATABASE_URL="postgresql://barbershop:barbershop@localhost:5432/barbershop?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000
NODE_ENV=development

# Public base URL of the web app, used to build client-facing
# reschedule/cancel links sent in notifications
WEB_BASE_URL="http://localhost:5173"

# Notification provider stub — set to "console" for local dev (logs
# instead of sending), swap to "twilio"/"sendgrid" later
NOTIFICATION_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
